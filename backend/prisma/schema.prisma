generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

enum StageStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
}

model Project {
  id            String        @id @default(uuid())
  title         String
  description   String?
  businessLogic String?       @db.Text
  status        ProjectStatus @default(PLANNING)
  githubRepo    String?
  settings      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  stages     Stage[]
  updateLogs UpdateLog[]
  members    Member[]
}

model UpdateLog {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  author    String
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stage {
  id        String      @id @default(uuid())
  title     String
  order     Int         @default(0)
  status    StageStatus @default(PLANNING)
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Member {
  id        String   @id @default(uuid())
  name      String
  role      String
  email     String?
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      Status    @default(TODO)
  stageId     String
  stage       Stage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  subtasks    Subtask[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Subtask {
  id        String   @id @default(uuid())
  title     String
  isDone    Boolean  @default(false)
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
